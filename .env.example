# -----------------------------------------------------------------------------
# EPIScode - Environment Variables Template
# Copia este archivo a `.env.local` para desarrollo local:
#   cp .env.example .env.local
# NUNCA subas `.env.local` ni pongas keys con prefijo NEXT_PUBLIC_ (se exponen al navegador).
# -----------------------------------------------------------------------------

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuración del entorno (development | production | test)
NODE_ENV=development

# --- Base de datos vectorial (docker-compose.yml) ----------------------------
POSTGRES_USER=episcode
POSTGRES_PASSWORD=episcode
POSTGRES_DB=episcode_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://episcode:episcode@localhost:5432/episcode_rag

# --- Embeddings: Hugging Face Inference API ----------------------------------
# Token (permiso "Read"): https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Debe coincidir con vector(N) en db/init/01-schema.sql
EMBEDDING_DIMENSIONS=384

# --- LLM: elige proveedor con LLM_PROVIDER=gemini | groq ---------------------
LLM_PROVIDER=gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
